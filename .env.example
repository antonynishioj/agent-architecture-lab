# Required: free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Generator (writes the answers) and judge (scores them). Two different
# Flash-Lite models: each has its own ~500 requests/day free quota, the judge
# is the newer/stronger one, and different models reduce self-preference bias.
# (Free Flash models allow only ~20 requests/day: too few for the judge.)
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_JUDGE_MODEL=gemini-3.5-flash-lite

# Free-tier limits. Check your project's real numbers at
# https://aistudio.google.com/rate-limit and adjust if needed.
GEMINI_RPM=10
GEMINI_JUDGE_RPM=10
GEMINI_RPD=500
GEMINI_JUDGE_RPD=500

# Optional: enables "search the web" for custom cases (free tier: 1,000 searches/month)
TAVILY_API_KEY=

# Optional sampling overrides
# GENERATOR_TEMPERATURE=0.3
# JUDGE_TEMPERATURE=0.0
# MAX_OUTPUT_TOKENS=4096
